  "cards": [
    {
      "dot": "cyan",
      "title": "The room",
      "items": [
        "Vonage carries the video and the shared whiteboard on one session",
        "Each speaker is transcribed on their own stream, so a turn is never attributed by voice"
      ]
    },
    {
      "dot": "emerald",
      "title": "Judging",
      "items": [
        "Jev returns typed answers with calibrated probabilities",
        "Code enumerates candidates from the transcript; the model only selects",
        "A gate drops anything aimed at the app rather than the lesson"
      ]
    },
    {
      "dot": "rose",
      "title": "What is kept",
      "items": [
        "Lessons write through after every judged turn, so a restart resumes",
        "The weakness profile is the claim no in-memory version could make",
        "Camera frames are deliberately never stored"
      ]
    }
  ]
