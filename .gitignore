# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Vonage application private key
vonage_private.key
*.key

data/

# Archify visual-check evidence, regenerated on demand
docs/architecture/*.visual-check.*

# Impeccable design tooling.
# The durable artefacts are kept: PRODUCT.md and DESIGN.md at the root, and the
# surface briefs that carry each surface's direction contract. What is ignored
# is the working output - review screenshots, comps, build state - which is
# regenerated on every run and is megabytes of PNG nobody reads twice.
/.impeccable/*
!/.impeccable/surfaces/
!/.impeccable/design.json
!/.impeccable/config.json
/.codex/
/.cursor/
