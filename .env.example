# Required. The System One key that powers every judgment in the notebook.
# Without it the lesson still replays, but nothing is classified.
TYPESAFE_API_KEY=replace-me

# Optional. Defaults to jev-latest.
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Vonage Video. Set both and the lesson opens a real room; leave them unset and
# the scripted lesson stands in. The application needs the "video" capability.
VONAGE_APPLICATION_ID=
# Path to the application's private key. Preferred over an inline key: the key
# never passes through shell history or a process listing.
VONAGE_PRIVATE_KEY_PATH=vonage_private.key
# Inline alternative, with literal \n between lines.
# VONAGE_PRIVATE_KEY=

# Gemini Live, used only to transcribe the lesson. The model returns what was
# said and never speaks; the tutor in this app is a person.
GOOGLE_API_KEY=

# Only needed to create or manage Vonage applications, not to run the app.
# VONAGE_API_KEY=
# VONAGE_API_SECRET=

# tldraw commercial licence, which removes the watermark. Read in the browser,
# so it must be present when the app is BUILT, not just when it runs.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
